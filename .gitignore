# Dependencies
node_modules/

# Next.js
.next/
out/

# Environment variables — NEVER commit these
# Broad pattern: catches .env.local, .env.production, and stray editor
# saves like ".env.localRESEND_API_KEY=.save" that the old rules missed.
.env*
!.env.example

# Misc
.DS_Store
*.pem
npm-debug.log*

# Upstream engine reference — vendored copy lives in lib/live-session/
tss-live/

# TypeScript incremental build info
*.tsbuildinfo
